# Environment — copy to .env and adjust for your deployment
# Never commit the real .env file.

# ── Application ───────────────────────────────────────────
APP_NAME=NetRakshak
APP_VERSION=0.1.0
APP_ENV=development          # development | production

# ── Server ────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── CORS ──────────────────────────────────────────────────
# Comma-separated list of allowed origins (development only).
# In production set to the exact URL where the frontend is served.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Database ──────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./netrakshak.db

# ── File storage ──────────────────────────────────────────
UPLOAD_DIR=./uploads
REPORTS_DIR=./reports
MAX_UPLOAD_SIZE_MB=100

# ── ML ────────────────────────────────────────────────────
ML_CONTAMINATION=0.05        # Isolation Forest contamination rate (0–0.5)
ML_ANOMALY_THRESHOLD=0.7     # Events with score above this escalate severity

# ── Logging ───────────────────────────────────────────────
LOG_LEVEL=INFO

