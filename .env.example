# ─────────────────────────────────────────────────────────────────────────────
# NetRakshak — Environment Configuration Template
# Copy to `.env` or `backend/.env` before running in production.
# NEVER commit production `.env` files containing actual secrets.
# ─────────────────────────────────────────────────────────────────────────────

# Application Identity
APP_NAME=NetRakshak
APP_VERSION=0.1.0
APP_ENV=development # Options: development, test, production

# Server Binding
HOST=0.0.0.0
PORT=8000

# Security & CORS
# Comma-separated list of allowed origins. Do not use '*' in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:80

# Database
# For SQLite offline operations (async aiosqlite driver required):
DATABASE_URL=sqlite+aiosqlite:///./netrakshak.db
# For PostgreSQL (if migrating in future):
# DATABASE_URL=postgresql+asyncpg://analyst:secret@localhost:5432/netrakshak

# File Storage
UPLOAD_DIR=./uploads
REPORTS_DIR=./reports
MAX_UPLOAD_SIZE_MB=100

# Machine Learning Parameters (Isolation Forest)
ML_CONTAMINATION=0.05
ML_ANOMALY_THRESHOLD=0.7

# Deterministic Security Detection Rules Thresholds
RULE_BRUTE_FORCE_THRESHOLD=3
RULE_BRUTE_FORCE_WINDOW_SECONDS=300
RULE_BURST_THRESHOLD=20
RULE_BURST_WINDOW_SECONDS=60
RULE_AFTER_HOURS_START=7   # 07:00 local time
RULE_AFTER_HOURS_END=20     # 20:00 local time
RULE_FAILED_THEN_SUCCESS_THRESHOLD=2

# Logging
LOG_LEVEL=INFO

